# Local / self-hosted Qwen (OpenAI-compatible endpoint)
# Demo mode can fall back deterministically when this is unset.
# Live mode requires this endpoint and will surface an error instead of falling back.
# Recommended Apple Silicon runner:
#   mlx_lm.server --model mlx-community/Qwen3.5-27B-4bit --host 127.0.0.1 --port 8080 --chat-template-args '{"enable_thinking":false}'
LOCAL_QWEN_CHAT_COMPLETIONS_URL=http://127.0.0.1:8080/v1/chat/completions
LOCAL_QWEN_MODEL=mlx-community/Qwen3.5-27B-4bit
LOCAL_QWEN_API_KEY=
LOCAL_QWEN_TIMEOUT_MS=30000

# Atlas Flight Booking CLI / sandbox credentials are configured outside this app
# according to the Atlas skill/CLI environment used by the deployment.
# The UI always boots in Demo mode; selecting Live disables simulated Atlas fallback.

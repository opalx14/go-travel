# Alibaba Cloud DashScope / Qwen
# Demo mode can fall back deterministically when this is unset.
# Live mode requires this key and will surface an error instead of falling back.
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-flash
QWEN_CHAT_COMPLETIONS_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1/chat/completions

# Atlas Flight Booking CLI / sandbox credentials are configured outside this app
# according to the Atlas skill/CLI environment used by the deployment.
# The UI always boots in Demo mode; selecting Live disables simulated Atlas fallback.

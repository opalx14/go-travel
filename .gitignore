# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# local SQLite device persistence
/.data/

# local model fine-tuning artifacts
/.artifacts/

# misc
.DS_Store
*.pem

# local AI model artifacts (weights stay outside Git/VPS)
*.safetensors
*.gguf
/.cache/huggingface/

# temporary headless-chrome profile used for screenshot evidence
/.chrome-cdp/

# local screenshot evidence from headless verification runs
/verify-*.png
/evidence-*.png

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep secrets local; commit only the documented template)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
